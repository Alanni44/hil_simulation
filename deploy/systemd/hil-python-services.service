[Unit]
Description=HIL Python bridge and UDP forwarding services
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=simple
User=hil
Group=hil
WorkingDirectory=/opt/hil/python_services
ExecStart=/opt/hil/venv/bin/python3 /opt/hil/python_services/main.py
Environment=HIL_CONTROLLED_PACKAGE_ROOT=/opt/hil/packages
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/hil/runtime /opt/hil/artifacts

[Install]
WantedBy=multi-user.target
