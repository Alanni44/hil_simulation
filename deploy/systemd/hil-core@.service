[Unit]
Description=HIL real-time model core (%i)
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target
ConditionPathExists=/opt/hil/runtime/verified/%i_rt

[Service]
Type=simple
User=hil
Group=hil
WorkingDirectory=/opt/hil
ExecStart=/opt/hil/runtime/verified/%i_rt
Restart=on-failure
RestartSec=2
UMask=0077

# Grant only the privileges required by sched_setscheduler() and mlockall().
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
LimitRTPRIO=99
LimitMEMLOCK=infinity
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/hil/runtime

[Install]
WantedBy=multi-user.target
