[Unit]
Description=HIL real-time model core (%i)
After=network-online.target systemd-tmpfiles-setup.service hil-python-services.service
Wants=network-online.target
Requires=hil-python-services.service

[Service]
Type=simple
User=hil
Group=hil
WorkingDirectory=/opt/hil
ConditionPathExists=/opt/hil/models/active/%i/executable/%i_rt
ExecStart=/opt/hil/models/active/%i/executable/%i_rt
Environment=HIL_MODEL_READY_SIGNAL=/run/hil/%i.signal
Environment=HIL_MODEL_NAME=%i
Restart=on-failure
RestartSec=2
UMask=0077

# Grant only the privileges required by sched_setscheduler() and mlockall().
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
LimitRTPRIO=99
LimitMEMLOCK=infinity
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/hil

[Install]
WantedBy=multi-user.target
