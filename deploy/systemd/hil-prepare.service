[Unit]
Description=HIL fixed first-circle preparation
After=hil-core@current.service
Requires=hil-core@current.service
Before=hil-gateway.service

[Service]
Type=oneshot
User=hil
Group=hil
WorkingDirectory=/opt/hil
ExecStart=/opt/hil/.venv/bin/python -m icd_gateway.prepare_minimal --contract-dir /opt/hil/docs/interfaces/baseline --expected-sha256 22163dc21526ceadd63260b3d5670404a1064c4301e52b2a80edcf41a4fe8a27 --template /opt/hil/config/minimal-integration-template.json --deployment /etc/hil/minimal-integration-gateway.json --c-core-endpoint quadrotor_hil=127.0.0.1:9997
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/hil /etc/hil

