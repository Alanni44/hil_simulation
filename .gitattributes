* text=auto
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.m text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Frozen ICD sources and published evidence are hashed as raw file bytes.
/docs/interfaces/** -text
/artifacts/icd_gateway/** -text
/artifacts/icd_runtime/** -text

# Preserve the two existing CRLF source snapshots named in historical evidence.
/c_core/src/hal_stub.c text eol=crlf
/c_core/src/hal_stub.h text eol=crlf
